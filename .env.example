# Salin file ini jadi ".env" (atau isi langsung di dashboard hosting Anda) dan sesuaikan nilainya.

# WAJIB DIGANTI — ini password untuk masuk ke /admin (panel kelola klien).
# Pakai password yang kuat, jangan yang mudah ditebak.
ADMIN_PASSWORD=ganti-dengan-password-kuat-anda

# Port server (kebanyakan hosting gratis mengisi otomatis, boleh dibiarkan)
PORT=3000

# Folder tempat data disimpan (klien, invoice, dst — berupa file JSON, bukan database
# yang perlu instalasi terpisah). Biarkan default kecuali hosting Anda mengharuskan
# path disk permanen tertentu (lihat README bagian "Persistensi Data").
# DATA_DIR=/data
